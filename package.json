{
  "name": "path-class",
  "version": "0.11.1-dev",
  "description": "A semantic `Path` class for `node` and `bun`. Inspired by `bun`'s [`file(…)`](https://bun.com/docs/runtime/file-io) API, but `node`-compatible.",
  "author": "Lucas Garron <code@garron.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lgarron/path-class.git"
  },
  "type": "module",
  "main": "./dist/lib/path-class/index.js",
  "types": "./dist/lib/path-class/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/path-class/index.d.ts",
      "import": "./dist/lib/path-class/index.js"
    },
    "./sync": {
      "types": "./dist/lib/path-class/sync/index.d.ts",
      "import": "./dist/lib/path-class/sync/index.js"
    }
  },
  "dependencies": {
    "xdg-basedir": "^5.1.0",
    "@types/node": ">=24.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@cubing/dev-config": ">=0.8.1",
    "@types/bun": "^1.3.0",
    "bun-dx": ">=0.1.3",
    "esbuild": "^0.25.10",
    "printable-shell-command": "^4.0.4",
    "readme-cli-help": ">=0.4.9",
    "typescript": "^5.9.3"
  },
  "files": [
    "./dist/",
    "./src"
  ],
  "scripts": {
    "prepublishOnly": "make prepublishOnly"
  }
}
